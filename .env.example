# LLM (toute API compatible OpenAI)
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL=mistral-small-latest

# Embeddings : BAAI/bge-m3 (défaut) ou intfloat/multilingual-e5-small (léger)
EMBEDDING_MODEL=BAAI/bge-m3
# Précision du modèle : float32 (défaut) | float16 (moitié moins de RAM, pour l'hébergement gratuit)
EMBEDDING_DTYPE=float32

# Stratégie de chunking : article | fixed
CHUNK_STRATEGY=article
